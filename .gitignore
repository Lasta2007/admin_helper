```gitignore
# Compiled and binary files
*.pyc
__pycache__/

# Dependencies
.venv/
venv/
pip-wheel-metadata/

# Logs and temp files
*.log
*.tmp
*.swp

# Environment
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# Coverage
.coverage
coverage/
htmlcov/

# Python specific
*.pyo
*.pyd
.Python
*.so
*.egg-info/
.eggs/
.mypy_cache/
.pytest_cache/
.tox/
.hypothesis/

# Build directories
build/
dist/
*.egg

# Original rules preserved
*.log
```