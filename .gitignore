```gitignore
# Compiled and build artifacts
*.pyc
__pycache__/

# Dependencies
.venv/
venv/
node_modules/

# Logs and temp files
*.log
*.tmp
*.swp

# Environment
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# Coverage reports
.coverage
coverage/
htmlcov/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# OS generated files
.DS_Store
Thumbs.db

# Python specific
.pytest_cache/
.mypy_cache/
*.pyo
*.pyd
*.so
*.dylib
*.dll

# Web specific
*.min.js
*.min.css
!static/js/app.js
!static/css/style.css

# Ignore compiled JavaScript but keep source
*.js.map
*.css.map

# Backup files
*~
*.bak
*.swp
*.swo

# IDE specific
.vs/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Compression files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```